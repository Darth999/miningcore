{
  "logging": {
    "level": "info",
    "enableConsoleLog": true,
    "enableConsoleColors": true
  },
  "notifications": {
    "enabled": false
  },
  "persistence": {
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "user": "miningcore",
      "password": "YOUR_POSTGRES_PASSWORD",
      "database": "miningcore"
    }
  },
  "paymentProcessing": {
    "enabled": true,
    "interval": 600,
    "coinbaseString": "YOUR_POOL_NAME"
  },
  "api": {
    "enabled": true,
    "listenAddress": "0.0.0.0",
    "port": 4000,
    "corsOrigins": ["*"]
  },
  "pools": [
    {
      "id": "acg",
      "enabled": true,
      "coin": "aurumcryptogold",
      "address": "YOUR_ACG_WALLET_ADDRESS",
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "banning": {
        "enabled": true,
        "time": 600,
        "invalidPercent": 50,
        "checkThreshold": 50
      },
      "ports": {
        "9989": {
          "name": "General ASIC",
          "listenAddress": "0.0.0.0",
          "difficulty": 1024,
          "varDiff": {
            "minDiff": 1,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 9888,
          "user": "YOUR_RPC_USER",
          "password": "YOUR_RPC_PASSWORD"
        }
      ],
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 0.001,
        "payoutScheme": "SOLO",
        "payoutSchemeConfig": {
          "factor": 2
        }
      },
      "rewardRecipients": [
        {
          "address": "YOUR_ACG_FEE_ADDRESS",
          "percentage": 0.5
        }
      ]
    },
    {
      "id": "dem",
      "enabled": true,
      "coin": "emark",
      "address": "YOUR_DEM_WALLET_ADDRESS",
      "pubKey": "YOUR_DEM_PUBKEY",
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "banning": {
        "enabled": true,
        "time": 600,
        "invalidPercent": 50,
        "checkThreshold": 50
      },
      "ports": {
        "9990": {
          "name": "General ASIC",
          "listenAddress": "0.0.0.0",
          "difficulty": 1024,
          "varDiff": {
            "minDiff": 1,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 4444,
          "user": "YOUR_RPC_USER",
          "password": "YOUR_RPC_PASSWORD"
        }
      ],
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 1,
        "payoutScheme": "SOLO",
        "payoutSchemeConfig": {
          "factor": 2
        }
      },
      "hasLegacyDaemon": true,
      "rewardRecipients": [
        {
          "address": "YOUR_DEM_FEE_ADDRESS",
          "percentage": 0.5
        }
      ]
    }
  ],
  "statistics": {
    "updateInterval": 120
  }
}
